# Portrait 1080x2160 panel mounted for landscape use.
# 111-sway-init reads fbcon rotate to set the sway output transform.
if [ -f "/sys/devices/virtual/graphics/fbcon/rotate" ]
then
  echo 3 > /sys/devices/virtual/graphics/fbcon/rotate
fi
